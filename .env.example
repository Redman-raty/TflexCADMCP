# Replace with the root of your installed T-FLEX CAD 18.
TFLEX_HOME=C:\Program Files\T-FLEX CAD Учебная Версия 18
TFLEX_MCP_TIMEOUT=180

# Uncomment for the educational macro when launching the server from PowerShell.
# TFLEX_MCP_MODE=education

# Optional overrides
# TFLEX_SDK_DIR=C:\Path\To\T-FLEX CAD 18\SDK
# TFLEX_API_XML=C:\Path\To\T-FLEX CAD 18\Program\TFlexAPI.xml
# TFLEX_REFERENCE_ROOT=C:\Path\To\net472\build
# TFLEX_MCP_INDEX=C:\Path\To\api.sqlite3
# TFLEX_MCP_PIPE_NAME=TFlexMcp.Custom
